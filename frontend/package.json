    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.2.11",
    "@angular/router": "^21.1.0",
    "@angular/service-worker": "^21.2.7",
    "@angular/ssr": "^21.2.9",
    "@sentry/angular": "^10.51.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.1.5",
