# CDN provider used by cdn_uploader.py
CDN_PROVIDER=imagekit

# Preferred single-endpoint credentials
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional fallback / rotation format (comma-separated)
# IMAGEKIT_URL_ENDPOINTS=https://ik.imagekit.io/endpoint_a,https://ik.imagekit.io/endpoint_b
# IMAGEKIT_PRIVATE_KEYS=private_key_a,private_key_b

# Optional behavior flags in cdn_uploader.py
# CDN_OVERWRITE=1
# CDN_STRICT=0
# CDN_REQUIRE_EXT=0
