# Cloudflare R2 (S3-compatible) settings for migration scripts
# Copy these values into environment variables (do not commit real secrets).

CDN_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional migration guards (recommended)
# CDN_MAX_UPLOAD_CALLS=200
# CDN_MAX_UPLOAD_BYTES=314572800
# CDN_UPLOADS_DISABLED=0
