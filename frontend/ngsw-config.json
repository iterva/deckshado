{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/icon-*.png",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/media/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "card-images",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "urls": [
          "https://wsrv.nl/**",
          "https://api.myl.cl/static/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "cloudinary-media",
      "urls": [
        "https://res.cloudinary.com/drw7y27sm/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 500,
        "maxAge": "30d",
        "timeout": "10s"
      }
    },
    {
      "name": "cards-api",
      "urls": [
        "https://iterva.pythonanywhere.com/api/cards/**",
        "https://iterva.pythonanywhere.com/api/formats/**",
        "https://iterva.pythonanywhere.com/api/teams/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 200,
        "maxAge": "1d",
        "timeout": "15s"
      }
    },
    {
      "name": "decks-api",
      "urls": [
        "https://iterva.pythonanywhere.com/api/decks/public/**",
        "https://iterva.pythonanywhere.com/api/decks/my/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "7d",
        "timeout": "15s"
      }
    }
  ]
}
