{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "deckshado-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "cwd": "frontend",
      "port": 4200
    },
    {
      "name": "deckshado-backend",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": ["backend/manage.py", "runserver", "8000"],
      "port": 8000
    }
  ]
}
